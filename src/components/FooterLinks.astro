---
import { Icon } from "@astrojs/starlight/components";
---

<div class="wrapper">
  <div class="socialLinks">
    <a href="https://www.facebook.com/adobe" target="_blank"
      ><Icon
        name="facebook"
        label="Facebook"
        size="1.25rem"
        color="#0066cc"
      /></a
    >
    <a href="https://www.instagram.com/adobe" target="_blank"
      ><Icon
        name="instagram"
        label="Instagram"
        size="1.25rem"
        color="#0066cc"
      /></a
    >
    <a href="https://www.twitter.com/adobe" target="_blank"
      ><Icon name="x.com" label="X.com" size="1.25rem" color="#0066cc" /></a
    >
    <a href="https://www.linkedin.com/company/adobe" target="_blank"
      ><Icon
        name="linkedin"
        label="LinkedIn"
        size="1.25rem"
        color="#0066cc"
      /></a
    >
  </div>

  <div class="footerLinks">
    <span class="copyright">Copyright © 2025 Adobe. All rights reserved.</span>
    <div class="adobeLinks">
      <a href="https://www.adobe.com/privacy.html" target="_blank"
        >&nbsp;Privacy /
      </a>
      <a href="https://www.adobe.com/privacy/cookies.html" target="_blank"
        >&nbsp;Terms of Use /
      </a>
      <a
        href="https://business.adobe.com/products/experience-manager/adobe-experience-manager.html?s_iid=7011O000003Jq1LQAS&s_cid=7015Y000003t8AeQAI&sdid=1SQHCYNX&mv=search&edtamo=true&ef_id=Cj0KCQiA0MG5BhD1ARIsAEcZtwSkN6r3-GMQvMCxPoBvhoa4KQzPFSmJ4tGuQSQ4TE3GbXhGNDcvDi4aArFEEALw_wcB:G:s&s_kwcid=AL!3085!3!704082603285!p!!g!!adobe%20experience%20management!21419948282!166867506231&gad_source=1&gclid=Cj0KCQiA0MG5BhD1ARIsAEcZtwSkN6r3-GMQvMCxPoBvhoa4KQzPFSmJ4tGuQSQ4TE3GbXhGNDcvDi4aArFEEALw_wcB"
        target="_blank"
        >&nbsp;Cookie preferences /
      </a>
      <a href="https://www.adobe.com/privacy/us-rights.html" target="_blank"
        >&nbsp; Do not sell my personal information /
      </a>
      <a
        href="https://www.adobe.com/privacy/opt-out.html#interest-based-ads"
        target="_blank">&nbsp;AdChoices</a
      >
    </div>
  </div>
</div>

<style>
  .wrapper {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 1rem;
    margin-top: 1rem;
    flex-wrap: wrap;
    text-align: center;
  }
  
  .footerLinks {
    display: flex;
    flex-direction: column;
    align-items: center;
    color: var(--sl-color-gray-2);
    font-size: 0.75rem;
    gap: 0.5rem;
    flex: 1;
    min-width: 0; /* Allow shrinking */
  }
  
  .adobeLinks {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    line-height: 1.4;
    justify-content: center;
  }
  
  .adobeLinks a {
    white-space: nowrap;
  }
  
  .socialLinks {
    color: var(--sl-color-accent);
    display: flex;
    gap: 1rem;
    flex-shrink: 0;
  }

  .copyright {
    margin-bottom: 0.25rem;
    display: block;
  }

  /* Mobile responsive adjustments */
  @media (max-width: 768px) {
    .wrapper {
      flex-direction: column;
      gap: 1rem;
      align-items: center;
    }
    
    .footerLinks {
      width: 100%;
      align-items: center;
    }
    
    .adobeLinks {
      flex-direction: column;
      gap: 0.5rem;
      align-items: center;
    }
    
    .adobeLinks a {
      padding: 0.25rem 0;
      border-bottom: 1px solid var(--sl-color-gray-6);
      text-align: center;
    }
    
    .adobeLinks a:last-child {
      border-bottom: none;
    }
    
    .socialLinks {
      justify-content: center;
      width: 100%;
    }
  }

  @media (max-width: 480px) {
    .footerLinks {
      font-size: 0.7rem;
    }
    
    .socialLinks {
      gap: 1.5rem;
    }
  }
</style>
