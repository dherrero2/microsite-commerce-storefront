---
import type { Props } from '@astrojs/starlight/props';

// Import MobileMenuToggle with proper typing
// @ts-ignore - Virtual module may not have types available
import MobileMenuToggle from 'virtual:starlight/components/MobileMenuToggle';

const { hasSidebar } = Astro.props;

// Provide fallback for aria-label
const sidebarAriaLabel = Astro.locals.t?.(['sidebarNav.accessibleLabel']) || 'Sidebar navigation';
---

<div class="page sl-flex">
  <header class="header"><slot name="header" /></header>
  {
    hasSidebar && (
      <nav class="sidebar" aria-label={sidebarAriaLabel}>
        <MobileMenuToggle {...Astro.props} />
        <div id="starlight__sidebar" class="sidebar-pane">
          <div class="sidebar-content sl-flex">
            <slot name="sidebar" />
          </div>
        </div>
      </nav>
    )
  }
  <div class="main-frame"><slot /></div>
</div>

<style>
  .page {
    flex-direction: column;
    min-height: 100vh;
    overflow-x: hidden;
    width: 100%;
    max-width: 100vw;
  }

  .header {
    z-index: var(--sl-z-index-navbar, 100);
    position: fixed;
    inset-inline-start: 0;
    inset-block-start: 0;
    width: 100%;
    max-width: 100vw;
    height: var(--sl-nav-height);
    border-bottom: 1px solid var(--sl-color-hairline-shade);
    padding: var(--sl-nav-pad-y) var(--sl-nav-pad-x);
    padding-inline-end: var(--sl-nav-pad-x);
    background-color: var(--sl-color-bg-nav);
    box-sizing: border-box;
    overflow-x: hidden;
  }

  :global([data-has-sidebar]) .header {
    padding-inline-end: calc(var(--sl-nav-gap) + var(--sl-nav-pad-x) + var(--sl-menu-button-size));
  }

  .sidebar-pane {
    visibility: var(--sl-sidebar-visibility, hidden);
    position: fixed;
    z-index: var(--sl-z-index-menu);
    inset-block: var(--sl-nav-height) 0;
    inset-inline-start: 0;
    width: 100%;
    max-width: 100vw;
    background-color: var(--sl-color-black);
    overflow-y: auto;
    overflow-x: hidden;
    box-sizing: border-box;
  }

  :global([aria-expanded='true']) ~ .sidebar-pane {
    --sl-sidebar-visibility: visible;
  }

  .sidebar-content {
    height: 100%;
    min-height: max-content;
    padding: 1rem var(--sl-sidebar-pad-x) 0;
    padding-top: 0.75rem;
    flex-direction: column;
    gap: 1rem;
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
    overflow-x: hidden;
  }

  /* Fix mobile responsive layout issue */
  .main-frame {
    padding-top: calc(var(--sl-nav-height) + var(--sl-mobile-toc-height));
    width: 100%;
    max-width: 100vw;
    box-sizing: border-box;
    overflow-x: hidden;
    min-height: 0;
  }

  /* Mobile-specific adjustments */
  @media (max-width: 49.9rem) {
    .main-frame {
      padding-inline-start: 0;
      padding-inline-end: 0;
      margin: 0;
    }
    
    .sidebar-pane {
      backdrop-filter: blur(4px);
      background-color: rgba(0, 0, 0, 0.95);
    }

    .header {
      left: 0;
      right: 0;
      margin: 0;
    }

    /* Ensure all child elements respect container width */
    .main-frame :global(*) {
      max-width: 100%;
      box-sizing: border-box;
    }

    /* Handle wide content like tables, code blocks */
    .main-frame :global(table) {
      width: 100%;
      table-layout: fixed;
      word-wrap: break-word;
    }

    .main-frame :global(pre) {
      overflow-x: auto;
      max-width: 100%;
    }

    .main-frame :global(img) {
      max-width: 100%;
      height: auto;
    }
  }

  /* Desktop layout with sidebar */
  @media (min-width: 50rem) {
    .main-frame {
      padding-inline-start: calc(var(--sl-sidebar-width) + 2rem);
    }
    
    .sidebar-content::after {
      content: '';
      padding-bottom: 1px;
    }
    
    :global([data-has-sidebar]) .header {
      padding-inline-end: var(--sl-nav-pad-x);
    }
    
    .sidebar-pane {
      --sl-sidebar-visibility: visible;
      width: var(--sl-sidebar-width);
      background-color: var(--sl-color-bg-sidebar);
      border-inline-end: 1px solid var(--sl-color-hairline-shade);
    }
  }

  /* Improved responsive breakpoints */
  @media (max-width: 768px) {
    .header {
      padding: var(--sl-nav-pad-y, 1rem) var(--sl-nav-pad-x, 0.75rem);
    }
    
    .sidebar-content {
      padding: 0.75rem var(--sl-sidebar-pad-x, 1rem) 0;
      gap: 0.75rem;
    }
  }

  /* Handle very small screens */
  @media (max-width: 480px) {
    .header {
      padding: var(--sl-nav-pad-y, 0.75rem) var(--sl-nav-pad-x, 0.5rem);
    }
    
    .main-frame {
      padding-top: calc(var(--sl-nav-height, 4rem) + var(--sl-mobile-toc-height, 0rem));
    }
  }
</style>
